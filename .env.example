# Required. Points at a Postgres you run locally; `make db-create` sets up the role and database.
DATABASE_URL=postgres://api2mcp:api2mcp@localhost:5432/api2mcp

# Server
A2M_HOST=127.0.0.1
A2M_PORT=8080
# Public origin. This is the OAuth issuer and the base for the .well-known documents, so it
# must be what clients actually reach — behind a reverse proxy, that is the external URL.
A2M_BASE_URL=http://localhost:8080
# Endpoint slug that bare POST /mcp resolves to.
A2M_DEFAULT_ENDPOINT=demo

# First user seeded on first boot. Both or neither. There is no "admin" — every signed-in user
# can read and write every definition.
A2M_SEED_EMAIL=
A2M_SEED_PASSWORD=

# Optional external OIDC provider for human login (GET /login offers it alongside the local
# password form). All three or none — a partially configured provider is a startup error, not a
# silent fallback. No client secret is ever stored in the database (I4); this is the only place
# it lives.
# A2M_OIDC_ISSUER=https://accounts.example.com
# A2M_OIDC_CLIENT_ID=...
# A2M_OIDC_CLIENT_SECRET=...

# Intended audit-retention window in days. Read into Config today, but nothing currently sweeps
# runs on it — there is no background retention task yet (store::session::purge_expired exists
# for sessions, but has no caller either). Setting this has no effect until that lands.
A2M_RUN_RETENTION_DAYS=30

# Browser session cookie lifetime, in hours. Default 720 (30 days).
# A2M_SESSION_TTL_HOURS=720

# Cap on an inbound request body, in bytes (applies to /api and /mcp alike). Default 1048576 (1 MiB).
# A2M_MAX_REQUEST_BYTES=1048576

# Let the SSRF guard accept loopback upstreams. Integration tests set this; nothing else should.
A2M_ALLOW_LOOPBACK_UPSTREAM=0

# Upstream credentials. An auth_provider row stores the KEY NAME below, never the value —
# there is no column anywhere in the schema that can hold a credential (I4).
# A2M_CRED_DEMO_TOKEN=...

# Password for `api2mcp user add` / `user passwd` when run non-interactively (e.g. in scripts or
# CI). Omit to be prompted on stdin instead. Not read by the server itself.
# A2M_CLI_PASSWORD=

# RUST_LOG=api2mcp=debug,info
